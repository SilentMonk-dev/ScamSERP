# Copy to .env; uvicorn --env-file .env loads these. Never commit real secrets.
SCAMSERP_MODE=demo
SCAMSERP_DATA_DIR=var
# Required for every admin operation. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCAMSERP_ADMIN_TOKEN=
SERPAPI_API_KEY=
GOOGLE_MAPS_API_KEY=
SCAMSERP_DAILY_CAP=20
SCAMSERP_MONTHLY_CAP=200
SCAMSERP_PUBLIC_LIVE=false
# Explicit risk-map searches use Search + Maps, bounded by the same credit caps.
SCAMSERP_MAP_SEARCH=true
# Enable a SINGLE dedicated scheduler process with `scamserp scheduler`, not web workers.
SCAMSERP_SCHEDULE_LIMIT=6
SCAMSERP_SCHEDULE_HOURS=6
# Start collection alongside a single web process; a lock prevents duplicate owners.
SCAMSERP_SCHEDULER=false
# Maximum Ads Transparency discovery/detail requests per Search run (0 disables).
SCAMSERP_ADS_REQUESTS_PER_RUN=2
SCAMSERP_MIN_RUNS=5
SCAMSERP_RATE_LIMIT=30
